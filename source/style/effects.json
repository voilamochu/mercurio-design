{
  "$schema": "v1",
  "description": "Mercurio Design System — Effect Tokens",
  "shadow": {
    "none": { "offsetX": 0, "offsetY": 0, "blur": 0, "spread": 0, "color": "#000000", "opacity": 0 },
    "low": { "offsetX": 0, "offsetY": 2, "blur": 4, "spread": 0, "color": "#000000", "opacity": 0.25 },
    "medium": { "offsetX": 0, "offsetY": 4, "blur": 12, "spread": 0, "color": "#000000", "opacity": 0.3 },
    "high": { "offsetX": 0, "offsetY": 8, "blur": 24, "spread": 0, "color": "#000000", "opacity": 0.35 }
  },
  "stroke": {
    "hairline": 0.5,
    "thin": 1,
    "medium": 2,
    "thick": 4
  },
  "opacity": {
    "disabled": 0.4,
    "muted": 0.6,
    "full": 1.0
  },
  "dash": {
    "dotted": [2, 2],
    "dashed": [6, 4]
  },
  "glow": {
    "none": { "offsetX": 0, "offsetY": 0, "blur": 0, "spread": 0, "color": "#3B82F6", "opacity": 0 },
    "low": { "offsetX": 0, "offsetY": 0, "blur": 6, "spread": 0, "color": "#3B82F6", "opacity": 0.35 },
    "medium": { "offsetX": 0, "offsetY": 0, "blur": 12, "spread": 2, "color": "#3B82F6", "opacity": 0.4 },
    "strong": { "offsetX": 0, "offsetY": 0, "blur": 20, "spread": 4, "color": "#3B82F6", "opacity": 0.5 }
  },
  "corner": {
    "smoothing": 0.6
  }
}
